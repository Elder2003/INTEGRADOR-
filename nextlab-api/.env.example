# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextlab?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# API Configuration
API_PORT=8080
LOG_LEVEL=info
APP_ENV=development

# JWT — must be at least 32 characters long
JWT_SECRET=your-secret-key-min-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Google OAuth — required for student login via @unifranz.edu.bo accounts
# See specs/003-academic-management/google-oauth-integration.md for replacement guidance
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
